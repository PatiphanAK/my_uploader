# Copy to .env.local for local development. These are PUBLIC build-time values
# inlined into the static bundle — never put secrets here.

# Base path when served from a sub-path, e.g. GitHub project pages: /universal-upload
NEXT_PUBLIC_BASE_PATH=

# Trusted backend profiles (JSON array). See docs/backend-integration.md.
# NEXT_PUBLIC_UPLOAD_PROFILES=[{"id":"tatarbot","name":"TatarBot","apiBaseUrl":"https://api.tatarbot.example/upload/v1","allowedUploadHosts":["*.r2.cloudflarestorage.com"],"hints":{"maxFileSize":524288000,"allowedExtensions":[".pdf",".md",".txt",".docx"]}}]

# Set to "false" to hide the in-browser mock profile.
NEXT_PUBLIC_ENABLE_MOCK=true
